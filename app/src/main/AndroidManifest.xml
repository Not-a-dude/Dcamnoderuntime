<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="com.dcamnoderuntime.permission.RUN_NODE"
        android:protectionLevel="signature" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name">
        <service
            android:name=".NodeRuntimeService"
            android:exported="true"
            android:permission="com.dcamnoderuntime.permission.RUN_NODE"
            android:process=":node_runtime">
            <intent-filter>
                <action android:name="com.dcam.node.BIND_RUNTIME" />
            </intent-filter>
        </service>
    </application>
</manifest>